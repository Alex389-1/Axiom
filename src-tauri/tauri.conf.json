{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Axiom",
  "version": "0.1.0",
  "identifier": "com.axiom.app",
  "build": {
    "beforeDevCommand": "cargo build --bin axiom-daemon && npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "cargo build --bin axiom-daemon --release && npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Axiom — Local AI Agent",
        "width": 1280,
        "height": 800,
        "minWidth": 800,
        "minHeight": 600,
        "decorations": true,
        "transparent": false,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["deb", "rpm", "appimage"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "shell": {
      "open": true
    }
  }
}
